                android:padding="5dp"
                android:text=""
                android:textColor="@color/white"
                android:textSize="18sp" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/frame3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
